{
  "buildCommand": "npm run build",
  "devCommand": "npm run dev",
  "installCommand": "npm install",
  "framework": null,
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "redirects": [
    {
      "source": "/impressum-%2F-kontakt",
      "destination": "/"
    },
    {
      "source": "/impressum-/-kontakt",
      "destination": "/"
    },
    {
      "source": "/impressum-%252F-kontakt",
      "destination": "/"
    }
  ]
}
